@model MedicalEquipmentManagement.ViewModels.NewPasswordInput
@{ ViewBag.Title = "Đặt lại mật khẩu"; }
<h1>@ViewBag.Title</h1>
<p>@ViewBag.Username</p>
@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()
    @Html.ValidationSummary()
    <div class="field">@Html.LabelFor(m => m.NewPassword) @Html.PasswordFor(m => m.NewPassword, new { autocomplete = "new-password" })</div>
    <div class="field">@Html.LabelFor(m => m.Confirmation) @Html.PasswordFor(m => m.Confirmation, new { autocomplete = "new-password" })</div>
    <button class="btn btn-primary" type="submit">Đặt lại mật khẩu</button>
    @Html.ActionLink("Quay lại", "Index", null, new { @class = "btn btn-ghost" })
}