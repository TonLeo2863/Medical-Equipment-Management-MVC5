@model MedicalEquipmentManagement.ViewModels.UserAdminInput
@{ ViewBag.Title = Model.UserId == 0 ? "Thêm tài khoản" : "Sửa tài khoản"; }
<section class="form-card">
<h1>@ViewBag.Title</h1>
@using (Html.BeginForm("Edit", "UserAdmin", new { id = Model.UserId == 0 ? (int?)null : Model.UserId }, FormMethod.Post, new { novalidate = "novalidate" }))
{
    @Html.AntiForgeryToken()
    @Html.ValidationSummary(true, "Vui lòng kiểm tra thông tin tài khoản.")
    <div class="field">@Html.LabelFor(m => m.Username) @Html.TextBoxFor(m => m.Username, new { maxlength = 50, autocomplete = "username" }) @Html.ValidationMessageFor(m => m.Username)</div>
    <div class="field">@Html.LabelFor(m => m.FullName) @Html.TextBoxFor(m => m.FullName, new { maxlength = 150 }) @Html.ValidationMessageFor(m => m.FullName)</div>
    <div class="field">@Html.LabelFor(m => m.Email) @Html.TextBoxFor(m => m.Email, new { type = "email", maxlength = 150 }) @Html.ValidationMessageFor(m => m.Email)</div>
    <div class="field">@Html.LabelFor(m => m.RoleId) @Html.DropDownListFor(m => m.RoleId, (SelectList)ViewBag.Roles, "Chọn vai trò") @Html.ValidationMessageFor(m => m.RoleId)</div>
    <div class="field field-check">@Html.CheckBoxFor(m => m.IsActive) @Html.LabelFor(m => m.IsActive)</div>
    if (Model.UserId == 0)
    {
        <p class="field-help">Mật khẩu phải dài từ 12 đến 256 ký tự. Nhập lại chính xác để xác nhận.</p>
    <div class="field">
        @Html.LabelFor(m => m.InitialPassword)
        <div class="password-field">
            @Html.PasswordFor(m => m.InitialPassword, new { autocomplete = "new-password", maxlength = 256, aria_describedby = "InitialPasswordError" })
            <button class="btn btn-ghost password-toggle" type="button" data-password="InitialPassword" aria-pressed="false">Hiện</button>
        </div>
        @Html.ValidationMessageFor(m => m.InitialPassword, null, new { id = "InitialPasswordError" })
    </div>
    <div class="field">
        @Html.LabelFor(m => m.InitialConfirmation)
        <div class="password-field">
            @Html.PasswordFor(m => m.InitialConfirmation, new { autocomplete = "new-password", maxlength = 256, aria_describedby = "InitialConfirmationError" })
            <button class="btn btn-ghost password-toggle" type="button" data-password="InitialConfirmation" aria-pressed="false">Hiện</button>
        </div>
        @Html.ValidationMessageFor(m => m.InitialConfirmation, null, new { id = "InitialConfirmationError" })
    </div>
    }
    <div class="actions">
        <button class="btn btn-primary" type="submit">Lưu tài khoản</button>
        @Html.ActionLink("Quay lại", "Index", null, new { @class = "btn btn-ghost" })
    </div>
}
</section>
