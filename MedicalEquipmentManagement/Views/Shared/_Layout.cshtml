<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewBag.Title · Thiết bị y tế</title>
    <link rel="stylesheet" href="@Url.Content("~/Content/Site.css")" />
</head>
<body>
    @Html.Partial("_Navbar")
    <main class="container">
        @{
            var controller = (string)ViewContext.RouteData.Values["controller"];
        }
        @if ((controller == "Home" || controller == "WorkOrder" || controller == "Calibration" || controller == "UserAdmin") && TempData["Success"] != null)
        {
            <p class="alert-success" role="status">@TempData["Success"]</p>
        }
        @RenderBody()
    </main>
    <footer class="site-footer">
        <div class="container footer-inner">
            <div class="footer-col"><strong>Quản lý thiết bị y tế</strong><p>Đồ án môn Lập trình Web</p></div>
        </div>
    </footer>
    <script src="@Url.Content("~/Scripts/site.js")"></script>
    @RenderSection("scripts", required: false)
</body>
</html>