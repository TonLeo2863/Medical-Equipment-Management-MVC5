@{
    var role = MedicalEquipmentManagement.Helpers.SessionAccount.HasBinding(ViewContext.HttpContext) ? Session["RoleCode"] as string : null;
    var name = Session["FullName"] as string;
    var manage = role == "ADMIN" || role == "MANAGER";
    var technical = manage || role == "ENGINEER";
}
<nav class="navbar" aria-label="Điều hướng chính">
    <div class="navbar-inner">
        <a class="brand" href="@Url.Action("Index", "Home")"><span class="brand-mark" aria-hidden="true">+</span><span class="brand-name">Thiết bị y tế</span></a>
        <label class="nav-toggle-label" for="navToggle">Menu</label>
        <input type="checkbox" id="navToggle" class="nav-toggle" />
        <ul class="nav-links">
            <li>@Html.ActionLink(role == null ? "Trang chủ" : "Tổng quan", "Index", "Home")</li>
            @if (role != null)
            {
                <li>@Html.ActionLink("Thiết bị", "Index", "Equipment")</li>
                <li>@Html.ActionLink("Phiếu sửa chữa", "Index", "WorkOrder")</li>
                if (manage)
                {
                    <li><details class="nav-group"><summary>Danh mục và kho</summary>
                        @Html.ActionLink("Danh mục thiết bị", "Index", "Category")
                        @Html.ActionLink("Nhà cung cấp", "Index", "Supplier")
                        @Html.ActionLink("Mẫu thiết bị", "Index", "EquipmentModel")
                        @Html.ActionLink("Kho và điều chuyển", "Index", "Inventory")
                        @if (role == "ADMIN")
                        {
                            @Html.ActionLink("Phòng ban", "Index", "Department")
                        }
                    </details></li>
                }
                if (technical)
                {
                    <li><details class="nav-group"><summary>Kỹ thuật</summary>
                        @Html.ActionLink("Bảo trì", "Index", "Maintenance")
                        @Html.ActionLink("Hiệu chuẩn", "Index", "Calibration")
                    </details></li>
                }
                <li><details class="nav-group"><summary>@(name ?? role)</summary>
                    @if (role == "ADMIN")
                    {
                        @Html.ActionLink("Quản lý tài khoản", "Index", "UserAdmin")
                    }
                    @Html.ActionLink("Đổi mật khẩu", "ChangePassword", "Account")
                    @using (Html.BeginForm("Logout", "Account", FormMethod.Post))
                    {
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-ghost">Đăng xuất</button>
                    }
                </details></li>
            }
            else
            {
                <li>@Html.ActionLink("Giới thiệu", "About", "Home")</li>
                <li>@Html.ActionLink("Đăng nhập", "Login", "Account")</li>
            }
        </ul>
    </div>
</nav>
