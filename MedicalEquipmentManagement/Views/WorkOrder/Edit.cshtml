@using MedicalEquipmentManagement.Models
@model WorkOrder
@{ ViewBag.Title = "Xử lý " + Model.TicketCode; }
<h1>@ViewBag.Title</h1>
<p>@Model.EquipmentAsset.AssetCode · @Model.Status</p>
@if ((bool)ViewBag.CanAssign)
{
    using (Html.BeginForm("Edit", "WorkOrder", new { id = Model.WorkOrderId }, FormMethod.Post))
    {
        @Html.AntiForgeryToken()
        <label for="engineerId">Kỹ sư</label>
        @Html.DropDownList("engineerId", (SelectList)ViewBag.Engineers, "Chọn kỹ sư", new { required = "required" })
        <button class="btn btn-primary" name="command" value="assign" type="submit">Lưu phân công</button>
    }
}
@if ((bool)ViewBag.IsAssigned && Model.Status != WorkOrderStatus.Completed)
{
    using (Html.BeginForm("Edit", "WorkOrder", new { id = Model.WorkOrderId }, FormMethod.Post))
    {
        @Html.AntiForgeryToken()
        if (Model.Status == WorkOrderStatus.Pending)
        {
            <button class="btn btn-primary" name="command" value="start" type="submit">Bắt đầu sửa</button>
        }
        else if (Model.Status == WorkOrderStatus.InProgress)
        {
            <div class="field">
                <label for="resolution">Kết quả sửa chữa</label>
                <textarea id="resolution" name="resolution" class="search-input" maxlength="500" required></textarea>
            </div>
            <div class="field">
                <label for="technicalPassed">Đánh giá kỹ thuật</label>
                <select name="technicalPassed" id="technicalPassed" required>
                    <option value="">Chọn kết quả</option><option value="true">Đạt</option><option value="false">Không đạt</option>
                </select>
            </div>
            <button class="btn btn-primary" name="command" value="complete" type="submit">Hoàn tất</button>
        }
    }
}
<p>@Html.ActionLink("Chi tiết phiếu", "Details", new { id = Model.WorkOrderId })</p>