@using MedicalEquipmentManagement.Models
@model IEnumerable<WorkOrder>
@{ ViewBag.Title = "Phiếu sửa chữa"; }
<h1>@ViewBag.Title</h1>
@if ((string)Session["RoleCode"] != "ENGINEER")
{
    @Html.ActionLink("Báo hỏng", "Create", null, new { @class = "btn btn-primary" })
}
@using (Html.BeginForm("Index", "WorkOrder", FormMethod.Get))
{
    <label for="keyword">Tìm phiếu</label>
    <input id="keyword" name="keyword" value="@ViewBag.Keyword" class="search-input" />
    <label for="status">Trạng thái</label>
    @Html.DropDownList("status", new SelectList(new[] { WorkOrderStatus.Pending, WorkOrderStatus.InProgress, WorkOrderStatus.Completed, WorkOrderStatus.Cancelled }, (string)ViewBag.Status), "Tất cả")
    <button class="btn btn-ghost" type="submit">Lọc</button>
}
<div class="table-responsive">
    <table class="table">
        <thead><tr><th>Mã phiếu</th><th>Thiết bị</th><th>Ngày báo</th><th>Kỹ sư</th><th>Trạng thái</th></tr></thead>
        <tbody>
        @foreach (var order in Model)
        {
            <tr><td>@Html.ActionLink(order.TicketCode, "Details", new { id = order.WorkOrderId })</td>
                <td>@order.EquipmentAsset.AssetCode</td><td>@order.CreatedDate.ToString("dd/MM/yyyy")</td>
                <td>@(order.AssignedUser?.FullName ?? "Chưa phân công")</td><td>@order.Status</td></tr>
        }
        </tbody>
    </table>
</div>
