@model MedicalEquipmentManagement.Models.WorkOrder
@{ ViewBag.Title = "Báo hỏng thiết bị"; }
<h1>@ViewBag.Title</h1>
@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()
    @Html.ValidationSummary()
    <div class="field">
        @Html.LabelFor(m => m.AssetId)
        @Html.DropDownList("AssetId", null, "Chọn thiết bị", new { @class = "search-input", required = "required" })
        @Html.ValidationMessageFor(m => m.AssetId)
    </div>
    <div class="field">
        @Html.LabelFor(m => m.IssueDescription)
        @Html.TextAreaFor(m => m.IssueDescription, new { rows = 5, maxlength = 500, required = "required", @class = "search-input" })
        @Html.ValidationMessageFor(m => m.IssueDescription)
    </div>
    <button class="btn btn-primary" type="submit">Gửi báo hỏng</button>
    @Html.ActionLink("Quay lại", "Index", null, new { @class = "btn btn-ghost" })
}