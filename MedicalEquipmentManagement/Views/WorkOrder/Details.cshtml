@using MedicalEquipmentManagement.Models
@model WorkOrder
@{ ViewBag.Title = Model.TicketCode; }
<h1>@Model.TicketCode</h1>
<dl>
    <dt>Thiết bị</dt><dd>@Model.EquipmentAsset.AssetCode · @Model.EquipmentAsset.EquipmentModel.ModelName</dd>
    <dt>Người báo</dt><dd>@(Model.ReporterVerified ? Model.Reporter.FullName : "Chưa xác minh (dữ liệu Beta)")</dd>
    <dt>Ngày báo</dt><dd>@Model.CreatedDate.ToString("dd/MM/yyyy HH:mm")</dd>
    <dt>Mô tả sự cố</dt><dd>@Model.IssueDescription</dd>
    <dt>Kỹ sư</dt><dd>@(Model.AssignedUser?.FullName ?? "Chưa phân công")</dd>
    <dt>Trạng thái</dt><dd>@Model.Status</dd>
    @if (Model.ResolvedDate.HasValue)
    {
        <dt>Thời điểm kết thúc</dt><dd>@Model.ResolvedDate.Value.ToString("dd/MM/yyyy HH:mm")</dd>
        <dt>Người kết thúc</dt><dd>@(Model.ResolvedBy?.FullName ?? "Chưa xác định")</dd>
        <dt>Kết quả</dt><dd>@Model.Resolution</dd>
        <dt>Đánh giá kỹ thuật</dt><dd>@(Model.TechnicalPassed == true ? "Đạt" : Model.TechnicalPassed == false ? "Không đạt" : "Chưa xác định")</dd>
    }
</dl>
@if ((bool)ViewBag.CanEdit && Model.Status != WorkOrderStatus.Completed && Model.Status != WorkOrderStatus.Cancelled)
{
    @Html.ActionLink("Xử lý phiếu", "Edit", new { id = Model.WorkOrderId }, new { @class = "btn btn-primary" })
}
@if ((string)Session["RoleCode"] == "ADMIN" && Model.Status == WorkOrderStatus.Pending && !Model.AssignedToUserId.HasValue)
{
    using (Html.BeginForm("Cancel", "WorkOrder", new { id = Model.WorkOrderId }, FormMethod.Post))
    {
        @Html.AntiForgeryToken()
        <div class="field"><label for="reason">Lý do hủy phiếu</label><input id="reason" name="reason" maxlength="500" required /></div>
        <button class="btn btn-ghost" type="submit" data-confirm="Tiếp tục hủy phiếu và lưu lý do vào lịch sử?">Hủy phiếu</button>
    }
}
@Html.ActionLink("Danh sách phiếu", "Index", null, new { @class = "btn btn-ghost" })
