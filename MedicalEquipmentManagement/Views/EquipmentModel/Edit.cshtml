@model MedicalEquipmentManagement.ViewModels.EquipmentModelFormViewModel

@{
    ViewBag.Title = "Chỉnh sửa Mẫu thiết bị";
}


<div class="page-header">
    <a href="@Url.Action("Index")" class="btn btn-ghost" style="margin-bottom: 12px; padding: 6px 14px; font-size: 13px;">
        ← Quay lại danh sách mẫu máy
    </a>
    <h2>Chỉnh sửa Mẫu thiết bị: [@Model.ModelCode] @Model.ModelName</h2>
    <h3>Cập nhật thông tin dòng thiết bị, danh mục phân loại và hãng sản xuất</h3>
</div>

<div style="max-width: 720px; margin: 0 auto; background: var(--color-surface); border-radius: var(--radius-lg); box-shadow: var(--shadow-sm); padding: 36px 32px;">
    @using (Html.BeginForm())
    {
        @Html.AntiForgeryToken()
        @Html.HiddenFor(m => m.ModelId)
        @Html.ValidationSummary(true, "", new { @class = "error" })

        <div class="field">
            @Html.LabelFor(m => m.ModelCode)
            @Html.TextBoxFor(m => m.ModelCode, new { @class = "search-input", style = "border-radius: var(--radius-sm);" })
            @Html.ValidationMessageFor(m => m.ModelCode, "", new { style = "color: var(--color-danger); font-size: 12px; margin-top: 4px; display: block;" })
        </div>

        <div class="field">
            @Html.LabelFor(m => m.ModelName)
            @Html.TextBoxFor(m => m.ModelName, new { @class = "search-input", style = "border-radius: var(--radius-sm);" })
            @Html.ValidationMessageFor(m => m.ModelName, "", new { style = "color: var(--color-danger); font-size: 12px; margin-top: 4px; display: block;" })
        </div>

        <div class="field">
            @Html.LabelFor(m => m.CategoryId)
            @Html.DropDownListFor(m => m.CategoryId, Model.CategoryList, "-- Chọn danh mục loại thiết bị --", new { @class = "search-input", style = "width: 100%; border-radius: var(--radius-sm);" })
            @Html.ValidationMessageFor(m => m.CategoryId, "", new { style = "color: var(--color-danger); font-size: 12px; margin-top: 4px; display: block;" })
        </div>

        <div class="field">
            @Html.LabelFor(m => m.ManufacturerId)
            @Html.DropDownListFor(m => m.ManufacturerId, Model.ManufacturerList, "-- Chọn hãng sản xuất (Manufacturer) --", new { @class = "search-input", style = "width: 100%; border-radius: var(--radius-sm);" })
            @Html.ValidationMessageFor(m => m.ManufacturerId, "", new { style = "color: var(--color-danger); font-size: 12px; margin-top: 4px; display: block;" })
        </div>

        <div class="field" style="display: flex; align-items: center; gap: 10px; margin-top: 8px;">
            @Html.CheckBoxFor(m => m.IsActive, new { id = "isActiveCheckbox", style = "width: 18px; height: 18px;" })
            <label for="isActiveCheckbox" style="margin-bottom: 0; cursor: pointer;">Đang lưu hành trong bệnh viện</label>
        </div>

        <div style="display: flex; gap: 12px; margin-top: 32px; justify-content: flex-end;">
            <a href="@Url.Action("Index")" class="btn btn-ghost">Hủy bỏ</a>
            <button type="submit" class="btn btn-primary">Cập nhật mẫu thiết bị</button>
        </div>
    }
</div>
