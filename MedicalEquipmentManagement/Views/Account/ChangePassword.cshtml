@model MedicalEquipmentManagement.ViewModels.ChangePasswordInput
@{ ViewBag.Title = "Đổi mật khẩu"; }
<h1>@ViewBag.Title</h1>
@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()
    @Html.ValidationSummary()
    <div class="field">@Html.LabelFor(m => m.CurrentPassword) @Html.PasswordFor(m => m.CurrentPassword, new { autocomplete = "current-password" })</div>
    <div class="field">@Html.LabelFor(m => m.NewPassword) @Html.PasswordFor(m => m.NewPassword, new { autocomplete = "new-password" })</div>
    <div class="field">@Html.LabelFor(m => m.Confirmation) @Html.PasswordFor(m => m.Confirmation, new { autocomplete = "new-password" })</div>
    <button type="submit" class="btn btn-primary">Lưu mật khẩu</button>
}