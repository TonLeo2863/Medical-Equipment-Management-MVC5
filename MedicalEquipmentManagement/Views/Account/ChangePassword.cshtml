@model MedicalEquipmentManagement.ViewModels.ChangePasswordInput
@{ ViewBag.Title = "Đổi mật khẩu"; }
<section class="form-card">
<h1>@ViewBag.Title</h1>

<p class="field-help">Mật khẩu mới phải dài từ 12 đến 256 ký tự. Nhập lại chính xác để xác nhận.</p>
@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()
    @Html.ValidationSummary(true, "Vui lòng kiểm tra thông tin mật khẩu.")
    <div class="field">
        @Html.LabelFor(m => m.CurrentPassword)
        <div class="password-field">
            @Html.PasswordFor(m => m.CurrentPassword, new { autocomplete = "current-password", maxlength = 256, aria_describedby = "CurrentPasswordError" })
            <button class="btn btn-ghost password-toggle" type="button" data-password="CurrentPassword" aria-pressed="false">Hiện</button>
        </div>
        @Html.ValidationMessageFor(m => m.CurrentPassword, null, new { id = "CurrentPasswordError" })
    </div>
    <div class="field">
        @Html.LabelFor(m => m.NewPassword)
        <div class="password-field">
            @Html.PasswordFor(m => m.NewPassword, new { autocomplete = "new-password", maxlength = 256, aria_describedby = "NewPasswordError" })
            <button class="btn btn-ghost password-toggle" type="button" data-password="NewPassword" aria-pressed="false">Hiện</button>
        </div>
        @Html.ValidationMessageFor(m => m.NewPassword, null, new { id = "NewPasswordError" })
    </div>
    <div class="field">
        @Html.LabelFor(m => m.Confirmation)
        <div class="password-field">
            @Html.PasswordFor(m => m.Confirmation, new { autocomplete = "new-password", maxlength = 256, aria_describedby = "ConfirmationError" })
            <button class="btn btn-ghost password-toggle" type="button" data-password="Confirmation" aria-pressed="false">Hiện</button>
        </div>
        @Html.ValidationMessageFor(m => m.Confirmation, null, new { id = "ConfirmationError" })
    </div>
    <button class="btn btn-primary" type="submit">Lưu mật khẩu</button>
}
</section>