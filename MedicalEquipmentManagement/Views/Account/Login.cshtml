@model MedicalEquipmentManagement.ViewModels.LoginInput
@{ ViewBag.Title = "Đăng nhập"; }
<section class="login-wrap">
    <div class="login-visual">
        <span class="brand-mark" aria-hidden="true">+</span>
        <h2>Quản lý thiết bị y tế</h2>
        <p>Theo dõi tài sản, điều chuyển, sửa chữa và lịch kỹ thuật.</p>
    </div>
    <div class="login-form">
        <h1>Đăng nhập</h1>
        @using (Html.BeginForm("Login", "Account", FormMethod.Post, new { novalidate = "novalidate" }))
        {
            @Html.AntiForgeryToken()
            @Html.ValidationSummary(true)
            <div class="field">
                <label for="username">Tên đăng nhập</label>
                @Html.TextBox("username", Model?.Username, new { autocomplete = "username", maxlength = 50, required = "required" })
                @Html.ValidationMessage("username")
            </div>
            <div class="field">
                <label for="password">Mật khẩu</label>
                <div class="password-field">
                    @Html.Password("password", null, new { autocomplete = "current-password", maxlength = 256, required = "required" })
                    <button class="btn btn-ghost password-toggle" type="button" data-password="password" aria-pressed="false">Hiện</button>
                </div>
                @Html.ValidationMessage("password")
            </div>
            <button class="btn btn-primary" type="submit">Đăng nhập</button>
        }
    </div>
</section>
