@model MedicalEquipmentManagement.ViewModels.DashboardViewModel
@{ ViewBag.Title = Model == null ? "Quản lý thiết bị y tế" : "Tổng quan thiết bị"; }

@if (Model == null)
{
    <section class="page-header">
        <h1>Quản lý thiết bị y tế</h1>
        <p>Tra cứu tài sản, theo dõi điều chuyển, bảo trì, hiệu chuẩn và sửa chữa.</p>
        @Html.ActionLink("Đăng nhập", "Login", "Account", null, new { @class = "btn btn-primary" })
    </section>
}
else
{
    <h1>@ViewBag.Title</h1>
    using (Html.BeginForm("Index", "Home", FormMethod.Get, new { @class = "dashboard-filters" }))
    {
        <div class="field">@Html.LabelFor(m => m.DepartmentId, "Khoa/phòng") @Html.DropDownListFor(m => m.DepartmentId, Model.DepartmentOptions, "Tất cả")</div>
        <div class="field">@Html.LabelFor(m => m.Days, "Thời hạn cảnh báo") @Html.DropDownListFor(m => m.Days, new SelectList(new[] { 15, 30 }))</div>
        if (Model.ShowCosts)
        {
            <div class="field">@Html.LabelFor(m => m.Year, "Năm thống kê chi phí") @Html.TextBoxFor(m => m.Year, new { type = "number", min = 1900, max = 9998 })</div>
        }
        <button class="btn btn-primary" type="submit">Áp dụng</button>
    }
    <div class="dashboard-grid">
        <article><span>Tổng thiết bị</span><strong>@Model.TotalAssets</strong></article>
        @foreach (var state in Model.States)
        {
            <article><span>@state.Label</span><strong>@state.Count</strong></article>
        }
        <article><span>Phiếu đang mở trong phạm vi</span><strong>@Model.OpenOrders</strong></article>
        <article><span>Khoa/phòng</span><strong>@Model.DepartmentCount</strong></article>
        <article><span>Đến hạn bảo trì</span><strong>@Model.MaintenanceDue</strong></article>
        <article><span>Đến hạn hiệu chuẩn</span><strong>@Model.CalibrationDue</strong></article>
    </div>
    <div class="dashboard-charts">
        <section><h2>Tình trạng thiết bị</h2><div class="chart-panel"><canvas id="asset-states" role="img" aria-label="Tỷ lệ tài sản theo trạng thái"></canvas></div></section>
        <section><h2>Thiết bị theo khoa/phòng</h2><div class="chart-panel"><canvas id="asset-departments" role="img" aria-label="Số tài sản theo khoa/phòng"></canvas></div></section>
        @if (Model.ShowCosts)
        {
            <section><h2>Chi phí bảo trì năm @Model.Year</h2><p>Tổng cộng @Model.AnnualCost.ToString("N0") VND</p><div class="chart-panel"><canvas id="maintenance-costs" role="img" aria-label="Chi phí bảo trì theo tháng"></canvas></div></section>
        }
    </div>
    <section>
        <h2>Cảnh báo ưu tiên</h2>
        @if (!Model.Alerts.Any())
        {
            <p>Không có thiết bị đến hạn trong phạm vi đã chọn.</p>
        }
        else
        {
            <div class="table-responsive">
                <table class="table"><thead><tr><th>Thiết bị</th><th>Loại</th><th>Hạn</th><th>Trạng thái</th></tr></thead>
                <tbody>
                @foreach (var alert in Model.Alerts)
                {
                    <tr><td>@Html.ActionLink(alert.AssetCode, "Details", "Equipment", new { id = alert.AssetId }, null)</td><td>@alert.Type</td>
                        <td>@alert.Due.ToString("dd/MM/yyyy")</td><td>@(alert.Due.Date < DateTime.Today ? "Quá hạn" : "Sắp đến hạn")</td></tr>
                }
                </tbody></table>
            </div>
        }
    </section>
    <div id="dashboard-data" hidden data-states="@Json.Encode(Model.States)" data-departments="@Json.Encode(Model.Departments)" data-costs="@Json.Encode(Model.MonthlyCosts)"></div>
}

@section scripts {
    @if (Model != null)
    {
        <script src="@Url.Content("~/Scripts/vendor/chart.umd.min.js")"></script>
        <script src="@Url.Content("~/Scripts/dashboard.js")"></script>
    }
}